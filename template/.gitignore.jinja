# Coverage.py
htmlcov/
reports/

# Copier
*.rej

# Data
{%- if with_dvc %}
# DVC adds the data it tracks to .gitignore files next to the data itself.
{%- else %}
data/*/*
!data/*/.gitkeep
!data/README.md
{%- endif %}
*.pickle*

# direnv
.envrc

# dotenv
.env

# Hypothesis
.hypothesis/

# Jupyter
.ipynb_checkpoints/
{%- if with_jupytext %}
# Notebooks are paired with .py files (Jupytext); git tracks the .py files only.
notebooks/*.ipynb
{%- endif %}

# Journal articles (copyrighted PDFs stay local; track the notes about them in notes/)
literature/**/*.pdf
literature/**/*.epub

# macOS
.DS_Store

# mise
mise.local.toml

# MkDocs
site/

# mypy
.dmypy.json
.mypy_cache/

# Node.js
node_modules/

# Obsidian (personal workspace state; the notes and shared settings are tracked)
notes/.obsidian/workspace*.json
notes/.obsidian/cache
notes/.trash/

# PyCharm
.idea/

# pyenv
.python-version

# pytest
.pytest_cache/

# Python
__pycache__/
*.egg-info/
*.py[cdo]
.venv/
dist/
{%- if with_snakemake %}

# Snakemake
.snakemake/
{%- endif %}

# Ruff
.ruff_cache/

# VS Code (shared settings are tracked; personal state is not)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
