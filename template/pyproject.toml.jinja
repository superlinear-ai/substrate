[build-system]  # https://docs.astral.sh/uv/concepts/build-backend/
requires = ["uv_build>=0.9.18,<0.10.0"]
build-backend = "uv_build"

[project]  # https://packaging.python.org/en/latest/specifications/pyproject-toml/
name = "{{ project_name_kebab_case }}"
version = "0.0.0"
description = "{{ project_description }}"
readme = "README.md"
authors = [
  { name = "{{ author_name }}", email = "{{ author_email }}" },
]
requires-python = ">={{ python_version }},<4.0"
dependencies = [
  "matplotlib>=3.9.0",
  "numpy>=2.0.0",
  "polars>=1.0.0",
  "scienceplots>=2.1.0",
  "scipy>=1.14.0",
]

[project.urls]  # https://packaging.python.org/en/latest/specifications/well-known-project-urls/#well-known-labels
homepage = "{{ project_url }}"
source = "{{ project_url }}"
{%- if with_conventional_commits %}
changelog = "{{ project_url.rstrip('/') }}/{% if ci == 'gitlab' %}-/{% endif %}blob/main/CHANGELOG.md"
{%- endif %}
documentation = "{{ documentation_url }}"
issues = "{{ project_url.rstrip('/') }}/{% if ci == 'gitlab' %}-/{% endif %}issues"

[dependency-groups]  # https://docs.astral.sh/uv/concepts/projects/dependencies/#development-dependencies
dev = [
  "codespell>=2.4.3",
  {%- if with_conventional_commits %}
  "commitizen>=4.17.1",
  {%- endif %}
  "coverage[toml]>=7.15.4",
  {%- if with_dvc %}
  "dvc>=3.50.0",
  {%- endif %}
  {%- if with_conventional_commits %}
  "git-cliff>=2.6.0",
  {%- endif %}
  "ipykernel>=7.3.0",
  "ipython>=9.16.1",
  "ipywidgets>=8.1.9",
  {%- if with_jupytext %}
  "jupytext>=1.16.0",
  {%- endif %}
  "mkdocs-material>=9.7.7",
  "nbstripout>=0.8.0",
  "poethepoet>=0.48.0",
  "prek>=0.2.0",
  "pytest>=9.1.1",
  "pytest-mock>=3.15.1",
  "pytest-xdist>=3.8.0",
  "ruff>=0.16.3",
  {%- if with_snakemake %}
  "snakemake>=9.0.0",
  {%- endif %}
  "ty>=0.0.73",
  {%- if typing == 'strict' %}
  "typeguard>=4.6.0",
  {%- endif %}
]

[tool.codespell]  # https://github.com/codespell-project/codespell
builtin = "en-GB_to_en-US,clear,code,rare"
check-filenames = true
skip = "./*_cache/,./.venv,./reports,./literature,./notes/.obsidian,./data,./results,./.snakemake"
{%- if with_conventional_commits %}

[tool.commitizen]  # https://commitizen-tools.github.io/commitizen/config/
bump_message = "bump: v$current_version → v$new_version"
tag_format = "v$version"
update_changelog_on_bump = false  # git-cliff generates CHANGELOG.md (see `poe changelog`)
version_provider = "uv"
{%- endif %}

[tool.coverage.report]  # https://coverage.readthedocs.io/en/latest/config.html#report
{%- if typing == 'strict' %}
fail_under = 50
{%- endif %}
precision = 1
show_missing = true
skip_covered = true

[tool.coverage.run]  # https://coverage.readthedocs.io/en/latest/config.html#run
branch = true
command_line = "--module pytest"
data_file = "reports/.coverage"
source = ["src"]

[tool.coverage.xml]  # https://coverage.readthedocs.io/en/latest/config.html#xml
output = "reports/coverage.xml"
{%- if with_jupytext %}

[tool.jupytext]  # https://jupytext.readthedocs.io/en/latest/config.html
formats = "ipynb,py:percent"
{%- endif %}

[tool.pytest.ini_options]  # https://docs.pytest.org/en/latest/reference/reference.html#ini-options-ref
addopts = "--color=yes --doctest-modules --exitfirst --failed-first{% if typing == 'strict' %} --strict-config --strict-markers{% endif %} --verbosity=2 --junitxml=reports/pytest.xml"
{%- if typing == 'strict' %}
filterwarnings = ["error", "ignore::DeprecationWarning"]
{%- endif %}
testpaths = ["src", "tests"]
xfail_strict = true

[tool.ruff]  # https://docs.astral.sh/ruff/settings/
fix = true
line-length = 100
src = ["src", "tests"]
target-version = "py{{ python_version.split('.')[:2] | join }}"

[tool.ruff.format]
docstring-code-format = true
skip-magic-trailing-comma = true

[tool.ruff.lint]
select = ["ALL"]
{%- if typing == 'strict' %}
ignore = ["CPY", "FIX", "ARG001", "COM812", "D203", "D213", "E501", "PD008", "PD009", "RET504", "S101", "TD003"]
{%- else %}
ignore = ["CPY", "FIX", "T20", "ARG001", "COM812", "D203", "D213", "E501", "PD008", "PD009", "PGH003", "RET504", "S101", "TD003"]
{%- endif %}
unfixable = ["ERA001", "F401", "F841", "T201", "T203"]

[tool.ruff.lint.per-file-ignores]
# Notebooks are scripts: allow top-level code, prints, bare expressions, and no module docstring.
"notebooks/**" = ["B018", "D100", "E402", "ERA001", "INP001", "PLR2004", "T201", "T203"]

[tool.ruff.lint.flake8-annotations]
allow-star-arg-any = true
{%- if typing == 'optional' %}
ignore-fully-untyped = true
{%- endif %}

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.isort]
split-on-trailing-comma = false

[tool.ruff.lint.pycodestyle]
max-doc-length = 100

[tool.ruff.lint.pydocstyle]
convention = "numpy"

[tool.ty.rules]
unused-ignore-comment = "warn"
{%- if typing == 'strict' %}

[tool.ty.terminal]
error-on-warning = true
{%- endif %}

[tool.poe.executor]  # https://github.com/nat-n/poethepoet
type = "simple"

[tool.poe.tasks]

  [tool.poe.tasks.docs]
  help = "Build or serve the documentation"
  shell = """
    if [ $serve ]
    then {
      mkdocs serve
    } else {
      mkdocs build
    } fi
    """

    [[tool.poe.tasks.docs.args]]
    help = "Serve the documentation locally with live reload"
    type = "boolean"
    name = "serve"
    options = ["--serve"]
{%- if with_jupytext %}

  [tool.poe.tasks.notebooks]
  help = "Sync the paired notebooks (.ipynb <-> .py) in notebooks/"
  shell = "jupytext --sync notebooks/*.py"
{%- endif %}
{%- if with_snakemake %}

  [tool.poe.tasks.workflow]
  help = "Run the Snakemake workflow (pass extra Snakemake arguments after --)"
  cmd = "snakemake --cores all --snakefile workflow/Snakefile"

  [tool.poe.tasks.dag]
  help = "Render the workflow's dependency graph to results/dag.svg"
  shell = "mkdir -p results && snakemake --snakefile workflow/Snakefile --dag | dot -Tsvg > results/dag.svg"
{%- endif %}
{%- if with_conventional_commits %}

  [tool.poe.tasks.changelog]
  help = "Regenerate CHANGELOG.md from the Conventional Commits history with git-cliff"
  cmd = "git-cliff --output CHANGELOG.md"
{%- endif %}

  [tool.poe.tasks.lint]
  help = "Lint this project"
  cmd = """
    prek run
      --all-files
      --color always
    """

  [tool.poe.tasks.test]
  help = "Test this project"

    [[tool.poe.tasks.test.sequence]]
    cmd = "coverage run"

    [[tool.poe.tasks.test.sequence]]
    cmd = "coverage report"

    [[tool.poe.tasks.test.sequence]]
    cmd = "coverage xml"
