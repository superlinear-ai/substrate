{
    "name": "{{ project_name_kebab_case }}",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/",
    "features": {
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
            "packages": "starship{% if with_snakemake %} graphviz{% endif %}"
        }
    },
    "overrideCommand": true,
    "remoteUser": "user",
    "onCreateCommand": "sudo chown -R user:user /opt/",
    "updateContentCommand": "uv sync --python ${localEnv:PYTHON_VERSION:{{ python_version }}} --all-extras",
    "postCreateCommand": "prek install --install-hooks",
    "customizations": {
        "jetbrains": {
            "backend": "PyCharm",
            "plugins": [
                "com.github.copilot"
            ]
        },
        "vscode": {
            "extensions": [
                "astral-sh.ty",
                "charliermarsh.ruff",
                {%- if ci == 'github' %}
                "GitHub.vscode-github-actions",
                "GitHub.vscode-pull-request-github",
                {%- elif ci == 'gitlab' %}
                "GitLab.gitlab-workflow",
                {%- endif %}
                "ms-azuretools.vscode-containers",
                {%- if with_jupytext %}
                "congyiwu.vscode-jupytext",
                {%- endif %}
                "ms-python.python",
                "ms-toolsai.jupyter",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "jupyter.kernels.excludePythonEnvironments": [
                    "/usr/local/bin/python"
                ],
                "python-envs.terminal.autoActivationType": "off",
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "terminal.integrated.env.linux": {
                    "GIT_EDITOR": "code --wait"
                }
            }
        }
    }
}
